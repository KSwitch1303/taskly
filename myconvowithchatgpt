🔥 5. POSTBACK ROUTE (CORE SYSTEM)
const express = require('express');
const router = express.Router();
const User = require('../models/User');
const Transaction = require('../models/Transaction');

router.get('/', async (req, res) => {
  const { user_id, amount, txid, secret } = req.query;

  // 🔐 Verify CPAgrip secret
  if (secret !== process.env.CPA_SECRET) {
    return res.status(403).send('Invalid secret');
  }

  // 🚫 Prevent duplicate rewards
  const existing = await Transaction.findOne({ txid });
  if (existing) {
    return res.send('Already credited');
  }

  // 💰 Calculate user reward (40%)
  const reward = amount * 0.4;

  // 💳 Credit user
  await User.findByIdAndUpdate(user_id, {
    $inc: { balance: reward }
  });

  // 🧾 Save transaction
  await Transaction.create({
    user_id,
    amount,
    txid
  });

  res.send('OK');
});

module.exports = router;
